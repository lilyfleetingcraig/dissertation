{
    "name": "web-blocks",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "test": "vitest run",
        "test:coverage": "npx vitest run --coverage",
        "test:watch": "vitest",
        "test:run": "vitest run",
        "typecheck": "tsc --noEmit",
        "build": "tsc && vite build",
        "preview": "vite preview"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@vitest/coverage-v8": "^4.1.8",
        "blockly": "^12.5.1",
        "eslint": "^10.4.1",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.6.0",
        "prettier": "^3.6.2",
        "typescript": "~6.0.2",
        "typescript-eslint": "^8.36.0",
        "vite": "^8.0.12",
        "vitest": "^4.1.8"
    }
}
